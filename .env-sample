# MongoDB LDAP connection over TLS
# Replace the placeholder credentials and host with your deployment values.
# LDAP authentication uses PLAIN with the external authentication source.
# Keep the CA bundle in the project directory or provide an absolute path.
MONGODB_URI=mongodb://ldap_username:ldap_password@mongodb.example.com:27017/?authMechanism=PLAIN&authSource=%24external&tls=true&tlsCAFile=ca-bundle-2026-08.pem
MONGODB_DB=stress_test

# Collection and time-series settings
CRUD_COLLECTION=crud_documents
TS_COLLECTION=sensor_measurements
TS_META_FIELD=metadata
TS_TIME_FIELD=timestamp
TS_GRANULARITY=seconds
TS_INDEX_NAME=metadata_device_timestamp

# Workload settings
TS_READ_WINDOW_SECONDS=3600
TS_READ_LIMIT=100
TS_INSERT_BATCH_SIZE=100
PAYLOAD_BYTES=256
DEVICE_COUNT=1000
MAX_LOCAL_CRUD_IDS=1000

# MongoDB connection timeouts, in milliseconds
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
